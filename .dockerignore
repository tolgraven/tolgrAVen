# Browser JavaScript and generated CSS directories are rebuilt by the production stage.
resources/public/js
resources/public/css/*/*

# Build artifacts and tools are not application inputs.
Dockerfile*
.dockerignore
docker-compose*.yml
docker-compose*.yaml
Makefile
doc
.github
.agents
.codex
scripts/**
!scripts/build/
!scripts/build/sync-vendor.mjs
!scripts/media/
!scripts/media/images.clj
# The standalone provisioning image needs only its launcher from ops.
!scripts/ops/
scripts/ops/**
!scripts/ops/entrypoint-supabase-provision.sh
.githooks
test
resources/docs/codox

# Host-only credentials must not enter builder layers.
profiles.clj
.env.*
.aws

# Repository instructions and deployment configuration are not application inputs.
AGENTS.md
**/AGENTS.md
deploy

# Ignore local aliases retained for an already-running development REPL.
src/clj
src/cljs

# Private overrides are never Docker build inputs.
config/local*.edn

!scripts/build/resolve_site.clj
resources/site.overrides.edn
resources/site.overrides.css

# Private runtime files cannot enter build layers.
env/dev/resources/config.edn
env/test/resources/config.edn

# Prepared assets are rebuilt in the frontend stage, never copied from the host.
resources/optimus
