{
  "name": "tolgraven.se",
  "version": "1.0.0",
  "dependencies": {
    "@mdxeditor/editor": "4.3.3",
    "@supabase/supabase-js": "2.117.3",
    "leaflet": "1.9.4",
    "lexical": "0.48.0",
    "lowlight": "3.3.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx-jsx": "3.2.0",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-mdx-jsx": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "init": "mkdir -p resources/public/css/website && npm ci && npm run vendor:sync",
    "sass:dev": "node scripts/build/styles.mjs --watch --sass-only",
    "sass:build": "node scripts/build/styles.mjs --sass-only",
    "postcss:dev": "node scripts/build/styles.mjs --watch --postcss-only",
    "postcss:build": "node scripts/build/styles.mjs --postcss-only",
    "dev": "node scripts/build/styles.mjs --watch",
    "build": "npm run vendor:sync && node scripts/build/styles.mjs",
    "update": "npm update",
    "vendor:sync": "node scripts/build/sync-vendor.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.29",
    "postcss-cli": "12.0.0",
    "postcss-value-parser": "4.2.0",
    "purgecss": "7.0.2",
    "sass-embedded": "1.105.1",
    "shadow-cljs": "3.5.7",
    "xmlhttprequest": "1.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "purgecss": {
      "postcss-selector-parser": "7.1.6",
      "glob": "13.0.6"
    }
  }
}
