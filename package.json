{
  "name": "tolgraven.se",
  "version": "1.0.0",
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "leaflet": "1.9.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "init": "mkdir -p resources/public/css/tolgraven && npm ci && npm run vendor:sync",
    "sass:dev": "node scripts/build/styles.mjs --watch --sass-only",
    "sass:build": "node scripts/build/styles.mjs --sass-only",
    "postcss:dev": "node scripts/build/styles.mjs --watch --postcss-only",
    "postcss:build": "node scripts/build/styles.mjs --postcss-only",
    "dev": "node scripts/build/styles.mjs --watch",
    "build": "npm run vendor:sync && node scripts/build/styles.mjs",
    "update": "npm update",
    "vendor:sync": "node scripts/build/sync-vendor.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.4",
    "postcss": "^8.5.29",
    "postcss-cli": "12.0.0",
    "sass": "^1.105.1",
    "shadow-cljs": "3.5.5",
    "xmlhttprequest": "1.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
