{:paths ["scripts" "src/cljc" "src/frontend" "resources"]
 :tasks
 {:requires ([babashka.process :as process]
             [media.images :as images]
             [media.staged :as staged]
             [media.videos :as videos]
             [dev.tasks :as dev]
             [dev.pr :as pr]
             [build.docker :as docker]
             [test.ssr :as ssr]
             [test.server :as server])
  pr {:doc "Wrap gh pr with owning/contributing Codex session attribution"
      :task (apply pr/-main *command-line-args*)}
  hooks {:doc "Install the tracked image and Codex session hooks"
         :task (staged/install!)}
  images {:doc "Convert bundled images, or explicit paths [--force] [--] [files...]"
          :task (apply images/-main *command-line-args*)}
  images:staged {:doc "Convert staged originals and stage their variants"
                 :task (staged/-main)}
  images:verify {:doc "Fail if any bundled image is missing its variants"
                 :task (images/verify!)}
  images:responsive {:doc "Discover large raster images and rebuild responsive AVIF/WebP sizes [--force]"
                     :task (apply images/responsive! *command-line-args*)}
  images:placeholders {:doc "Sample build-time color gradients without changing rendition bytes"
                       :task (images/placeholders!)}
  images:responsive:verify {:doc "Verify sized image codecs, dimensions and total bytes"
                            :task (images/responsive-verify!)}
  videos {:doc "Convert MP4 to muted VP9/AV1 WebM [--force] [files...]"
          :task (apply videos/-main *command-line-args*)}
  videos:responsive {:doc "Rebuild the opt-in responsive video catalog's renditions"
                     :task (videos/responsive!)}
  fonts:icons {:doc "Regenerate declared SVG icons and font subsets with Python/fontTools (see doc/styles.md)"
              :task (process/shell "python3" "scripts/media/icon_fonts.py")}
  prod:build {:doc "Build isolated local production document, browser, SSR and return-worker assets"
              :task (dev/production-local!)}
  audit {:doc "Measure isolated production bundles [label]"
         :task (apply dev/audit! *command-line-args*)}
  cpu {:doc "Scoped native CPU monitor and two-slot CPU-capped Docker/low-priority host launcher [action options -- command]"
       :task (apply dev/cpu! *command-line-args*)}
  cleanup {:doc "Report task caches; --apply prunes, --worktree PATH --remove-worktree verifies and retires a merged task"
           :task (apply process/shell "python3" "scripts/dev/cleanup.py" *command-line-args*)}
  pair {:doc "Run the installed re-frame-pair skill [operation args...]"
        :task (apply dev/pair! *command-line-args*)}
  ssr:fixtures {:doc "Check the generic Node renderer and generate hydration fixtures [--worker path]"
                :task (apply ssr/-main *command-line-args*)}
  test:browser {:doc "Serve Shadow browser tests [--port 4002]"
                :task (apply server/-main *command-line-args*)}
  test:visual {:doc "Capture native Chrome fixtures or fail exact pixel/geometry comparisons [capture|compare args]"
               :task (apply process/shell "python3" "scripts/test/visual.py" *command-line-args*)}
  test:integration {:doc "Serve live checks through the streaming Python proxy [args...]"
                    :task (apply dev/integration! *command-line-args*)}
  test:scripts {:doc "Run isolated Babashka/media/operations tests"
                :task (dev/test!)}
  site:resolve {:doc "Snapshot CMS capability and CSS variable overrides before building"
                :task (do (require 'build.resolve-site) (apply (resolve 'build.resolve-site/-main) *command-line-args*))}
  site:manifest {:doc "Print declaration-derived site/schema JSON, or SQL [sql]"
                 :task (do (require 'build.site) (apply (resolve 'build.site/-main) *command-line-args*))}
  supabase {:doc "Run the native JVM provisioner [schema|import|all args...]"
            :task (apply dev/supabase! *command-line-args*)}
  docker {:doc "Docker [registry|prefab|build|push|deploy|clean|pin|check-pin|metadata]"
          :task (apply docker/-main *command-line-args*)}}}
