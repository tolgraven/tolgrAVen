  let b:browsefilter = "Ruby Source Files (*.rb)\t*.rb\n"
  if has("win32")
    let b:browsefilter .= "All Files (*.*)\t*\n"
  else
    let b:browsefilter .= "All Files (*)\t*\n"
  endif
endif

