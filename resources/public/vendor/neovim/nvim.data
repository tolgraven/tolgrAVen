" Maintainer: Jang Whemoon <palindrom615@gmail.com>
" Last Change: Nov 24, 2020
"
"
"
" Unlike Japanese or Chinese, modern Korean texts do not depends on conversion
" to Hanja (Chinese character). Thus, general Korean text totally can be
" covered without help of IME but this keymap. 
" 
" BUT, simply mapping each letter of Hangul with sequence of alphabet 1 by 1
" can fail to combine Hangul jamo (conconants and vowels) right.
" For example, sequentially pressing `„ÖÖ„Öì„Öá„Öú„Ñπ„Ñ∑„Öê„Öé„Öè„Ñ±„Öõ` can not only be
" combined as `ÏÑúÏö∏ÎåÄÌïôÍµê`, but also `ÏÑ±„Öú„ÑπÎåõ„Öè„Ñ±Íµê`, which is totally 
" nonsense. 
" Though combining Hangul is deterministic with law that each letter must be 
" one of (consonant + vowel) or (consonant + vowel + consonant), there is no
" way to apply such law without implementing input engine.
"
" Thus, user of this keymap should wait until previous hangul letter is
" completed before typing next one. To reduce such inconvenience, I suggest to
" set `timeoutlen` with their own value. (default value is 1000ms)

source <sfile>:p:h/korean-dubeolsik_utf-8.vim
" Vim Keymap file for lithuanian characters, phonetic layout 'Baltic'
" Useful mainly with utf-8 but may work with other encodings

" Maintainer:   Alex Jakushev <Alex.Jakushev@kemek.lt>
" Last Changed: 2002 Apr 12

" All characters are given literally, conversion to another encoding (e.g.,
" UTF-8) should work.
scriptencoding utf-8

let b:keymap_name = "lt"

loadkeymap
!	ƒÑ	LITHUANIAN CAPITAL A NOSINE
@	ƒå	LITHUANIAN CAPITAL CH
#	ƒò	LITHUANIAN CAPITAL E NOSINE
$	ƒñ	LITHUANIAN CAPITAL E SU TASKU
%	ƒÆ	LITHUANIAN CAPITAL I NOSINE
^	≈†	LITHUANIAN CAPITAL SH
&	≈≤	LITHUANIAN CAPITAL U NOSINE
*	≈™	LITHUANIAN CAPITAL U SU BRUKSNIU
+	≈Ω	LITHUANIAN CAPITAL ZH
1	ƒÖ	LITHUANIAN LOWERCASE A NOSINE
2	ƒç	LITHUANIAN LOWERCASE CH
3	ƒô	LITHUANIAN LOWERCASE E NOSINE
4	ƒó	LITHUANIAN LOWERCASE E SU TASKU
5	ƒØ	LITHUANIAN LOWERCASE I NOSINE
6	≈°	LITHUANIAN LOWERCASE SH
7	≈≥	LITHUANIAN LOWERCASE U NOSINE
8	≈´	LITHUANIAN LOWERCASE U SU BRUKSNIU
=	≈æ	LITHUANIAN LOWERCASE ZH
" Maintainer:   Laszlo Zavaleta <zavaleta@smartchat.net.au>
" Last Changed: 2003 Aug 08
" it has all the accents and a few of the character alterations

let b:keymap = "magyar"

loadkey
`	√≠
~	√ç
!	'
@	"
#	+
$	!
^	/
&	=
*	(
(	)
0	√∂
)	√ñ
-	√º
_	√ú
=	√≥
+	√ì
\\	≈±
|	≈∞
[	≈ë
{	≈ê
]	√∫
}	√ö
;	√©
:	√â
'	√°
\"	√Å
/	-
<	?
>	:
?	_
" Maintainer:   Natsagdorj Shagdar <natsag2000@yahoo.com>
" Last Changed: 2007 Jun 26

" All characters are given literally, conversion to another encoding (e.g.,
" UTF-8) should work.
scriptencoding utf-8

let b:keymap_name = "mn"

loadkeymap
C	–Å	CYRILLIC CAPITAL LETTER IO
c	—ë	CYRILLIC SMALL LETTER IO
G	–ê	CYRILLIC CAPITAL LETTER A
D	–ë	CYRILLIC CAPITAL LETTER BE
>	–í	CYRILLIC CAPITAL LETTER VE
U	–ì	CYRILLIC CAPITAL LETTER GHE
:	–î	CYRILLIC CAPITAL LETTER DE
_	–ï	CYRILLIC CAPITAL LETTER IE
R	–ñ	CYRILLIC CAPITAL LETTER ZHE
P	–ó	CYRILLIC CAPITAL LETTER ZE
N	–ò	CYRILLIC CAPITAL LETTER I
A	–ô	CYRILLIC CAPITAL LETTER SHORT I
{	–ö	CYRILLIC CAPITAL LETTER KA
L	–õ	CYRILLIC CAPITAL LETTER EL
B	–ú	CYRILLIC CAPITAL LETTER EM
Y	–ù	CYRILLIC CAPITAL LETTER EN
K	–û	CYRILLIC CAPITAL LETTER O
\"	–ü	CYRILLIC CAPITAL LETTER PE
J	–†	CYRILLIC CAPITAL LETTER ER
V	–°	CYRILLIC CAPITAL LETTER ES
M	–¢	CYRILLIC CAPITAL LETTER TE
E	–£	CYRILLIC CAPITAL LETTER U
Q	–§	CYRILLIC CAPITAL LETTER EF
H	–•	CYRILLIC CAPITAL LETTER HA
W	–¶	CYRILLIC CAPITAL LETTER TSE
X	–ß	CYRILLIC CAPITAL LETTER CHE
I	–®	CYRILLIC CAPITAL LETTER SHA
+	–©	CYRILLIC CAPITAL LETTER SHCHA
}	–™	CYRILLIC CAPITAL LETTER HARD SIGN
