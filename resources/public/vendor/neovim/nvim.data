CompilerSet errorformat=
            \%-G,
            \%-G\ %#+-\ %.%#,
            \%-Ginstall,
            \%-Ginstall\ transitive\ failure,
            \%-Grun,
            \%-Grun\ transitive\ failure,
            \%-Gtest,
            \%-Gtest\ transitive\ failure,
            \%-Gfailed\ command:\ %.%#,
