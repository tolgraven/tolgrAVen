syn match diffIsA	"^–§–∞–π–ª .* —Ü–µ .*, —Ç–æ–¥—ñ —è–∫ —Ñ–∞–π–ª .* -- .*"
syn match diffNoEOL	"^\\ –ù–∞–ø—Ä–∏–∫—ñ–Ω—Ü—ñ —Ñ–∞–π–ª—É –Ω–µ–º–∞—î –Ω–æ–≤–æ–≥–æ —Ä—è–¥–∫–∞"
syn match diffCommon	"^–°–ø—ñ–ª—å–Ω—ñ –ø—ñ–¥–∫–∞—Ç–∞–ª–æ–≥–∏: .* —Ç–∞ .*"

" vi
syn match diffOnly	"^Ch·ªâ trong .*"
syn match diffIdentical	"^Hai t·∫≠p tin .* v√† .* l√† b·∫±ng nhau.$"
syn match diffIdentical	"^C·∫£ .* v√† .* l√† c√πng m·ªôt t·∫≠p tin$"
syn match diffDiffer	"^Hai t·∫≠p tin .* v√† .* l√† kh√°c nhau.$"
syn match diffBDiffer	"^Hai t·∫≠p tin nh·ªã ph√¢n .* v√† .* kh√°c nhau$"
syn match diffIsA	"^T·∫≠p tin .* l√† m·ªôt .* trong khi t·∫≠p tin .* l√† m·ªôt .*.$"
syn match diffBDiffer	"^Hai t·∫≠p tin .* v√† .* l√† kh√°c nhau.$"
syn match diffIsA	"^T·∫≠p tin .* l√† m·ªôt .* c√≤n t·∫≠p tin .* l√† m·ªôt .*.$"
syn match diffNoEOL	"^\\ Kh√¥ng c√≥ k√Ω t·ª± d√≤ng m·ªõi t·∫°i k√™t th·ª©c t·∫≠p tin."
syn match diffCommon	"^Th∆∞ m·ª•c con chung: .* v√† .*"

" zh_CN
syn match diffOnly	"^Âè™Âú® .* Â≠òÂú®Ôºö.*"
syn match diffIdentical	"^Êñá‰ª∂ .* Âíå .* Áõ∏Âêå$"
syn match diffDiffer	"^Êñá‰ª∂ .* Âíå .* ‰∏çÂêå$"
syn match diffBDiffer	"^‰∫åËøõÂà∂Êñá‰ª∂ .* Âíå .* ‰∏çÂêå$"
syn match diffIsA	"^Êñá‰ª∂ .* ÊòØ.*ËÄåÊñá‰ª∂ .* ÊòØ.*"
syn match diffNoEOL	"^\\ Êñá‰ª∂Â∞æÊ≤°Êúâ newline Â≠óÁ¨¶"
syn match diffCommon	"^.* Âíå .* ÊúâÂÖ±ÂêåÁöÑÂ≠êÁõÆÂΩï$"

" zh_TW
syn match diffOnly	"^Âè™Âú® .* Â≠òÂú®Ôºö.*"
syn match diffIdentical	"^Ê™îÊ°à .* Âíå .* Áõ∏Âêå$"
syn match diffDiffer	"^Ê™îÊ°à .* Ëàá .* ‰∏çÂêå$"
syn match diffBDiffer	"^‰∫åÂÖÉÁ¢ºÊ™î .* Ëàá .* ‰∏çÂêå$"
syn match diffIsA	"^Ê™îÊ°à .* ÊòØ.*ËÄåÊ™îÊ°à .* ÊòØ.*"
syn match diffNoEOL	"^\\ Ê™îÊ°àÊú´Ê≤íÊúâ newline Â≠óÂÖÉ"
syn match diffCommon	"^.* Âíå .* ÊúâÂÖ±ÂêåÁöÑÂâØÁõÆÈåÑ$"

endif


syn match diffRemoved	"^-.*"
syn match diffRemoved	"^<.*"
syn match diffAdded	"^+.*"
syn match diffAdded	"^>.*"
syn match diffChanged	"^! .*"

syn match diffSubname	" @@..*"ms=s+3 contained
syn match diffLine	"^@.*" contains=diffSubname
syn match diffLine	"^\<\d\+\>.*"
syn match diffLine	"^\*\*\*\*.*"
syn match diffLine	"^---$"

" Some versions of diff have lines like "#c#" and "#d#" (where # is a number)
syn match diffLine	"^\d\+\(,\d\+\)\=[cda]\d\+\>.*"

syn match diffFile	"^diff\>.*"
syn match diffFile	"^Index: .*"
syn match diffFile	"^==== .*"

if search('^@@ -\S\+ +\S\+ @@', 'nw', '', 100)
  " unified
  syn match diffOldFile	"^--- .*"
  syn match diffNewFile	"^+++ .*"
else
  " context / old style
  syn match diffOldFile	"^\*\*\* .*"
  syn match diffNewFile	"^--- .*"
endif

" Used by git
syn match diffIndexLine	"^index \x\x\x\x.*"

syn match diffComment	"^#.*"

