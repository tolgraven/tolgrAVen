function FormatRrst()
  if search('^\.\. {r', "bncW") > search('^\.\. \.\.$', "bncW")
    setlocal comments=:#',:###,:##,:#
  else
    setlocal comments=fb:*,fb:-,fb:+,n:>
  endif
  return 1
endfunction

