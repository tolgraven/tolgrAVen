syn keyword cmodStatement	UPDATE_LOCATION UNSAFE_IS_ZERO SAFE_IS_ZERO
syn keyword cmodStatement	MKPCHARP_STR APPLY_MASTER current_storage
syn keyword cmodStatement	PIKE_MAP_VARIABLE size_shift
