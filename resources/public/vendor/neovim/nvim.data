    iabbrev <buffer> (<) ‚äÇ
    iabbrev <buffer> (<+) ‚âº
    iabbrev <buffer> (<=) ‚äÜ
    iabbrev <buffer> (>) ‚äÉ
    iabbrev <buffer> (>+) ‚âΩ
    iabbrev <buffer> (>=) ‚äá
    iabbrev <buffer> (\|) ‚à™
    iabbrev <buffer> (^) ‚äñ
    iabbrev <buffer> (atomic) ‚öõ
    iabbrev <buffer> (cont) ‚àã
    iabbrev <buffer> (elem) ‚àà
    iabbrev <buffer> * √ó
    iabbrev <buffer> **0 ‚Å∞
    iabbrev <buffer> **1 ¬π
    iabbrev <buffer> **2 ¬≤
    iabbrev <buffer> **3 ¬≥
    iabbrev <buffer> **4 ‚Å¥
    iabbrev <buffer> **5 ‚Åµ
    iabbrev <buffer> **6 ‚Å∂
    iabbrev <buffer> **7 ‚Å∑
    iabbrev <buffer> **8 ‚Å∏
    iabbrev <buffer> **9 ‚Åπ
    iabbrev <buffer> ... ‚Ä¶
    iabbrev <buffer> / √∑
    iabbrev <buffer> << ¬´
    iabbrev <buffer> <<[=]<< ¬´=¬´
    iabbrev <buffer> <<[=]>> ¬´=¬ª
    iabbrev <buffer> <= ‚â§
    iabbrev <buffer> =~= ‚âÖ
