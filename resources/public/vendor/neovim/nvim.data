runtime! ftplugin/basic[.]{vim,lua}

let s:not_end = '\%(end\s\+\)\@<!'

let b:match_words ..= ',' ..
		\     s:not_end .. '\<declare\>:\<end\s\+declare\>,' ..
		\     '\<select\s\+everycase\>:\%(select\s\+\)\@<!\<case\%(\s\+\%(else\|is\)\)\=\>:\<end\s\+select\>,' ..
		\     '$IF\>:$\%(ELSEIF\|ELSE\)\>:$END\s*IF\>'

unlet s:not_end

let &cpo = s:cpo_save
unlet s:cpo_save

