                                \ geometry guiwid hue jpeg monitor-dotclock
                                \ monitor-hfreq monitor-vfreq monitoraspect
                                \ nograbpointer nokeepaspect noxv ontop panscan
                                \ rootwin saturation screenw stop-xscreensaver
