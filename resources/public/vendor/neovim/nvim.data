let b:undo_ftplugin = "setl cms< "

" Win32 and GTK can filter files in the browse dialog
"if (has("gui_win32") || has("gui_gtk")) && !exists("b:browsefilter")
"  if has("win32")
"    let b:browsefilter ..= "All Files (*.*)\t*\n"
