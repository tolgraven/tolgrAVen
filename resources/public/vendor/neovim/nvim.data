function! GetConTeXtIndent()
  " Use MetaPost rules inside MetaPost graphic environments
  if len(synstack(v:lnum, 1)) > 0 &&
        \ synIDattr(synstack(v:lnum, 1)[0], "name") ==# 'contextMPGraphic'
    return GetMetaPostIndent()
  endif
  return -1
endfunc

