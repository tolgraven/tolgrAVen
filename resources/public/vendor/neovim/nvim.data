scriptencoding utf-8

let b:keymap_name = "de"

loadkeymap
`` ^ ASCII CIRCUMFLEX
`e √™ LATIN SMALL LETTER E WITH CIRCUMFLEX
`u √ª LATIN SMALL LETTER U WITH CIRCUMFLEX
`i √Æ LATIN SMALL LETTER I WITH CIRCUMFLEX
`o √¥ LATIN SMALL LETTER O WITH CIRCUMFLEX
`a √¢ LATIN SMALL LETTER A WITH CIRCUMFLEX
`E √ä LATIN CAPITAL LETTER E WITH CIRCUMFLEX
`U √õ LATIN CAPITAL LETTER U WITH CIRCUMFLEX
`I √é LATIN CAPITAL LETTER I WITH CIRCUMFLEX
`O √î LATIN CAPITAL LETTER O WITH CIRCUMFLEX
`A √Ç LATIN CAPITAL LETTER A WITH CIRCUMFLEX
- √ü LATIN SMALL LETTER SZ
== ¬¥ ASCII ACUTE ACCENT
=e √© LATIN SMALL LETTER E WITH ACUTE
=u √∫ LATIN SMALL LETTER U WITH ACUTE
=i √≠ LATIN SMALL LETTER I WITH ACUTE
=o √≥ LATIN SMALL LETTER O WITH ACUTE
=a √° LATIN SMALL LETTER A WITH ACUTE
=z √Ω LATIN SMALL LETTER Y WITH ACUTE
=E √â LATIN CAPITAL LETTER E WITH ACUTE
=U √ö LATIN CAPITAL LETTER U WITH ACUTE
=I √ç LATIN CAPITAL LETTER I WITH ACUTE
=O √ì LATIN CAPITAL LETTER O WITH ACUTE
=A √Å LATIN CAPITAL LETTER A WITH ACUTE
=Z √ù LATIN CAPITAL LETTER Y WITH ACUTE
=S ·∫û LATIN CAPITAL LETTER SZ
++ ` ASCII GRAVE
+e √® LATIN SMALL LETTER E WITH GRAVE
+u √π LATIN SMALL LETTER U WITH GRAVE
+i √¨ LATIN SMALL LETTER I WITH GRAVE
+o √≤ LATIN SMALL LETTER O WITH GRAVE
+a √† LATIN SMALL LETTER A WITH GRAVE
