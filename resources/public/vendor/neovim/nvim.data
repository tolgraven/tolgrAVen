let b:current_syntax = "help"

let &cpo = s:cpo_save
unlet s:cpo_save
" vim: ts=8 sw=2
" Vim syntax file
" Language:	Italian Vim program help files *.itx
" Maintainer:	The Vim Project <https://github.com/vim/vim>
" Last Change:	2024 Oct 16
"
" This script is sourced from syntax/help.vim.

syn keyword helpNote		nota Nota NOTA nota: Nota: NOTA: notare Notare NOTARE notare: Notare: NOTARE:
syn match helpNote		"\c(nota\(:\|\>\)"ms=s+1
syn match helpSpecial		"Nma"me=e-2
syn match helpSpecial		"Nme"me=e-2
syn match helpSpecial		"Nmi"me=e-2
syn match helpSpecial		"Nmo"me=e-2
syn match helpSpecial		"\[interv.]"
syn region helpNotVi		start="{non" start="{solo" start="{disponibile" end="}" contains=helpLeadBlank,helpHyperTextJump

" vim: ts=8 sw=2
" Vim syntax file
" Language:     Russian Vim program help files *.rux
" Maintainer:   Restorer (restorers@users.sourceforge.net DEFUNCT)
" Last Change:  04 Aprl 2017
" 

" –ü—Ä–æ–≤–µ—Ä—è–µ–º —è–∑—ã–∫ –ª–æ–∫–∞–ª–∏ –∏ —É—Å—Ç–∞–Ω–æ–≤–∫–∏ –æ–ø—Ü–∏–∏ 'helplang'
" –ï—Å–ª–∏ –Ω–µ —Ä—É—Å—Å–∫–∏–π, —Ç–æ –≤—ã—Ö–æ–¥–∏–º –∏–∑ —Å–∫—Ä–∏–ø—Ç–∞.
if (v:lang !~? 'ru' || v:lang !~? 'russian') && &helplang !~? 'ru'
  finish
endif

" –ü–æ–¥—Å–≤–µ—Ç–∫–∞ —Ä—É—Å—Å–∫–∏—Ö –≥–∏–ø–µ—Ä—Å—Å—ã–ª–æ–∫
syntax match helpHyperTextJump	"\\\@<!|[^"*~# |]\+|" contains=helpBar
syntax match helpHyperTextEntry	"\*[^"*|]\+\*\s"he=e-1 contains=helpStar
syntax match helpHyperTextEntry	"\*[^"*|]\+\*$" contains=helpStar

" –ó–∞–≥–æ–ª–æ–≤–æ–∫ —Å—Ç–∞—Ç—å–∏, —Ä–∞–∑–¥–µ–ª–∞ –∏ —Ç. –ø.
syntax match helpHeadline   "^[–ê-–Ø–Å]\{2}[ .]\=[-,–ê-–Ø–ÅA-Z0-9 .()]*"

" –ù–∞–∏–º–µ–Ω–æ–≤–∞–Ω–∏–µ —Å–ø—Ä–∞–≤–æ—á–Ω–∏–∫–∞
" –Ω–æ–≤—ã–π –∑–∞–≥–æ–ª–æ–≤–æ–∫
" syntax match helpVim      "\<–°–ü–†–ê–í–û–ß–ù–ò–ö –ü–û –†–ï–î–ê–ö–¢–û–†–£ VIM\>"
"—Å—Ç–∞—Ä—ã–π –∑–∞–≥–æ–ª–æ–≤–æ–∫
syntax match helpVim      "\<–°–ü–†–ê–í–û–ß–ù–ò–ö –ü–û .*"
" –Ω–æ–≤—ã–π –∑–∞–≥–æ–ª–æ–≤–æ–∫
"syntax match helpVim      "\<–†–£–ö–û–í–û–î–°–¢–í–û –ü–û–õ–¨–ó–û–í–ê–¢–ï–õ–Ø –†–ï–î–ê–ö–¢–û–†–û–ú VIM\>"
"syntax match helpVim      "\<–∞–≤—Ç–æ—Ä\%[—ã:] .*$"
"—Å—Ç–∞—Ä—ã–π –∑–∞–≥–æ–ª–æ–≤–æ–∫
syntax match helpVim      "\<–†–£–ö–û–í–û–î–°–¢–í–û –ü–û–õ–¨–ó–û–í–ê–¢–ï–õ–Ø .*"
" –ü–æ–¥—Å–≤–µ—Ç–∫–∞ –ø—Ä–∏–º–µ—á–∞–Ω–∏–π –≤ —Ç–µ–∫—Å—Ç–µ, –Ω–∞—á–∞–ª–∞ –ø—Ä–∏–º–µ—Ä–æ–≤ –∏ —Ç.–ø.
syntax keyword helpNote     –ü—Ä–∏–º–µ—á–∞–Ω–∏–µ. –°–æ–≤–µ—Ç. –ü—Ä–∏–º–µ—Ä. –ü—Ä–∏–º–µ—Ä—ã:
syntax keyword helpWarning   –í–Ω–∏–º–∞–Ω–∏–µ!
" –≤ —Å—Ç–∞—Ä–æ–π –≤–µ—Ä—Å–∏–∏ –¥–æ–∫—É–º–µ–Ω—Ç–∞—Ü–∏–∏
syntax keyword helpNote     –ó–∞–º–µ—á–∞–Ω–∏–µ:
" –≤ —Å—Ç–∞—Ä–æ–π –≤–µ—Ä—Å–∏–∏ –¥–æ–∫—É–º–µ–Ω—Ç–∞—Ü–∏–∏
syntax keyword helpWarning   –í–ù–ò–ú–ê–ù–ò–ï! –ü—Ä–µ–¥—É–ø—Ä–µ–∂–¥–µ–Ω–∏–µ:
" –ü–æ–¥—Å–≤–µ—Ç–∫–∞ Ex-–∫–æ–º–∞–Ω–¥ –≤ –¥–æ–∫—É–º–µ–Ω—Ç–∞—Ü–∏–∏ Vim
syntax match helpCommand     "\":[A-Za-z!]\+\""hs=s+1,he=e-1
" –ü–æ–¥—Å–≤–µ—Ç–∫–∞ —Å–ø–µ—Ü–∏–∞–ª—å–Ω—ã—Ö –æ–±–æ–∑–Ω–∞—á–µ–Ω–∏–π
syntax match helpSpecial    "{[-–∞-—è—ë–ê-–Ø–Å0-9'":%#=[\]<>.,]\+}"
syntax match helpSpecial    "{[-–∞-—è—ë–ê-–Ø–Å0-9'"*+/:%#=[\]<>.,]\+}"
syntax match helpSpecial    "\s\[[-–∞-—è—ë^–ê-–Ø–Å0-9_]\{2,}]"ms=s+1
syntax match helpSpecial    "<[-–∞-—è—ë–ê-–Ø–Å0-9_]\+>"
syntax match helpSpecial    "\[–¥–∏–∞–ø–∞–∑–æ–Ω]"
syntax match helpSpecial    "\[—Å—á—ë—Ç—á–∏–∫]"
syntax match helpSpecial    "\[—á–∏—Å–ª–æ]"
syntax match helpSpecial    "\[+—á–∏—Å–ª–æ]"
syntax match helpSpecial    "\[-—á–∏—Å–ª–æ]"
syntax match helpSpecial    "\[–∫–æ–ª-–≤–æ]"
syntax match helpSpecial    "\[—Å—Ç—Ä–æ–∫–∞]"
syntax match helpSpecial    "\[—Å–º–µ—â–µ–Ω–∏–µ]"
syntax match helpSpecial    "\[–ø–∞—Ä–∞–º–µ—Ç—Ä]"
syntax match helpSpecial    "\[–ø–∞—Ä–∞–º–µ—Ç—Ä—ã]"
syntax match helpSpecial    "CTRL-{—Å–∏–º–≤–æ–ª}"
syntax region helpNotVi     start="{–î–æ—Å—Ç—É–ø–Ω–æ —Ç–æ–ª—å–∫–æ" start="{–í —Ä–µ–¥–∫—Ç–æ—Ä–µ Vim" start="{–í —Ä–µ–¥–∞–∫—Ç–æ—Ä–µ Vi" end="}" contains=helpLeadBlank,helpHyperTextJump
" –ü–æ–¥—Å–≤–µ—Ç–∫–∞ –ø—Ä–∏–º–µ—á–∞–Ω–∏–π –ø–µ—Ä–µ–≤–æ–¥—á–∏–∫–∞
syntax region helpTrnsNote  start="\[–ü—Ä–∏–º. –ø–µ—Ä–µ–≤–æ–¥." end="]" contains=helpComment
" –û–ø—Ä–µ–¥–µ–ª–µ–Ω–∏–µ –≥—Ä—É–ø–ø—ã –ø–æ–¥—Å–≤–µ—Ç–∫–∏ Ex-–∫–æ–º–∞–Ω–¥ –≤ –¥–æ–∫—É–º–µ–Ω—Ç–∞—Ü–∏–∏ Vim
"hi def link helpCommand     vimCommand
" –û–ø—Ä–µ–¥–µ–ª–µ–Ω–∏–µ –≥—Ä—É–ø–ø—ã –ø–æ–¥—Å–≤–µ—Ç–∫–∏ –ø—Ä–∏–º–µ—á–∞–Ω–∏–π –ø–µ—Ä–µ–≤–æ–¥—á–∏–∫–∞
hi def link helpTrnsNote    Comment
" hi def link helpTrnsNote    Comment
"
" vim: ts=8 sw=2
" Vim syntax file
" Language:	Hercules
" Maintainer:	Dana Edwards <Dana_Edwards@avanticorp.com>
" Extensions:   *.vc,*.ev,*.rs
" Last change:  Nov. 9, 2001
" Comment:      Hercules physical IC design verification software ensures
"		that an IC's physical design matches its logical design and
"		satisfies manufacturing rules.

" quit when a syntax file was already loaded
if exists("b:current_syntax")
  finish
endif

" Ignore case
syn case ignore

" Hercules runset sections
syn keyword   herculesType	  header assign_property alias assign
syn keyword   herculesType	  options preprocess_options
syn keyword   herculesType	  explode_options technology_options
syn keyword   herculesType	  drc_options database_options
syn keyword   herculesType	  text_options lpe_options evaccess_options
syn keyword   herculesType	  check_point compare_group environment
syn keyword   herculesType	  grid_check include layer_stats load_group
syn keyword   herculesType	  restart run_only self_intersect set snap
