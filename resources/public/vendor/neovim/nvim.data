n	<char-238>	" ◊û - mem
o	<char-237>	" ◊ù - final mem
p	<char-244>	" ◊§ - pe
q	/		" / - slash
r	<char-248>	" ◊® - resh
s	<char-227>	" ◊ì - dalet
t	<char-224>	" ◊ê - alef
u	<char-229>	" ◊ï - vav
v	<char-228>	" ◊î - he
w	'		" ' - single-quote
x	<char-241>	" ◊° - samekh
y	<char-232>	" ◊ò - tet
z	<char-230>	" ◊ñ - zayin
,	<char-250>	" ◊™ - tav
.	<char-245>	" ◊• - final tsadi
;	<char-243>	" ◊£ - final pe
'	,		" , - comma
/	.		" . - period
`	;		" ; - semicolon
