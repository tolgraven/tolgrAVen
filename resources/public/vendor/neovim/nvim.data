unlet s:cpo_save
" Vim filetype plugin
" Language:		Ruby
" Maintainer:		Tim Pope <vimNOSPAM@tpope.org>
" URL:			https://github.com/vim-ruby/vim-ruby
" Last Change:		2023 Dec 31
"			2024 Jan 14 by Vim Project (browsefilter)
