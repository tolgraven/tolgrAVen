" Vim Keymap file for Sinhala (Sri Lanka) (2003-11-02)
" Maintainer  : Harshula Jayasuriya <harshula@gmail.com>
" Last Updated: 2007-06-30
" This is a phonetic static mapping for a standard US-English keyboard
" (qwerty)
" http://www.nongnu.org/sinhala/doc/keymaps/sinhala-keyboard_3.html

" Copy the keymap to ~/.vim/keymap/
" Start gvim
" Need to disable the menu so that you can use the 'alt' key.
"   set guioptions-=m
" Select the new keymap
"   set keymap=sinhala-phonetic_utf-8

let b:keymap_name = "sinhala"

loadkeymap
<A-n>	<char-0x0d82>	"  ‡∂Ç - anusvaraya (anusvara)
H	<char-0x0d83>	"  ‡∂É - visargaya (visarga)
a	<char-0x0d85>	" ‡∂Ö - ayanna (a)
A	<char-0x0d86>	" ‡∂Ü - aayanna (aa)
w	<char-0x0d87>	" ‡∂á - aeyanna (ae)
W	<char-0x0d88>	" ‡∂à - aeeyanna (aee)
i	<char-0x0d89>	" ‡∂â - iyanna (i)
I	<char-0x0d8a>	" ‡∂ä - iiyanna (ii)
u	<char-0x0d8b>	" ‡∂ã - uyanna (u)
U	<char-0x0d8c>	" ‡∂å - uuyanna (uu)
